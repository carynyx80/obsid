# Copy to .env for local dev (never commit real values).
# Railway injects PORT automatically.
PORT=8080

# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
# Leave empty to use the in-memory store (local dev / tests; data is lost on restart).
DATABASE_URL=

# Set to true only when connecting over a public URL that requires TLS (not needed on Railway private networking).
PGSSL=false

# Admin wallet (case insensitive). Defaults to 0x7d6b84648Fe791b2a2623b8B4D6fbB00ce7daB76 when unset.
ADMIN_WALLET=0x7d6b84648Fe791b2a2623b8B4D6fbB00ce7daB76

# Comma separated list of allowed browser origins.
CORS_ORIGIN=https://www.obsid.site,https://obsid.site,http://localhost:3000

# Seed demo hosts and sales on boot when the store is empty.
SEED_DEMO=false

# Optional tuning
RATE_LIMIT_MAX=600
NONCE_RATE_LIMIT_MAX=30
BODY_LIMIT=100kb
TRUST_PROXY=1
